{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "generated_at",
    "hostname",
    "overall_severity",
    "findings",
    "run_metadata"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "hostname": {
      "type": "string",
      "minLength": 1
    },
    "overall_severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "finding.schema.json"
      }
    },
    "notes_for_analyst": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "run_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latency_ms",
        "schema_pass",
        "agents_run"
      ],
      "properties": {
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "schema_pass": {
          "type": "boolean"
        },
        "agents_run": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}